{
  "manifest_version": 3,
  "name": "Connect Attendance Sync",
  "version": "1.0.1",
  "description": "Review and sync BRAC Connect attendance from your database API.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://bracu.partho.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Attendance Sync settings",
    "default_icon": {
      "32": "icons/icon-32.png",
      "16": "icons/icon-16.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://connect.bracu.ac.bd/*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icons/icon-128.png",
    "48": "icons/icon-48.png",
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png"
  }
}
